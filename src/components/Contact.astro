---
import SectionLayout from '@/layouts/general/SectionLayout.astro';
import RectangleLayout from '@/layouts/general/RectangleLayout.astro';
import ColumnsGridLayout from '@/layouts/general/ColumnsGridLayout.astro';

import ContactLink from '@/components/general/ContactLink.astro';
import SectionDescription from '@/components/general/SectionDescription.astro';

import { contactLinks } from '@/data/contactLinks';
---
<SectionLayout id="contact" ariaLabelledby="contact-heading">
	<RectangleLayout>
		<SectionDescription
			header="Let's work together"
			subheader="Contact"
			description="Have a project in mind or want to chat about web development? Reach out — I'd love to hear from you."
			headingId="contact-heading"
		/>

		<ColumnsGridLayout columns={3}>
			{
				contactLinks.map((link) => (
					<ContactLink {...link} />
				))
			}
		</ColumnsGridLayout>
	</RectangleLayout>
</SectionLayout>
