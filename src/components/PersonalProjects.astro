---
import SectionLayout from '@/layouts/general/SectionLayout.astro';
import ColumnsGridLayout from '@/layouts/general/ColumnsGridLayout.astro';

import SectionDescription from '@/components/general/SectionDescription.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';

import { personalProjects } from '@/data/personalProjects';
---

<SectionLayout id="projects" ariaLabelledby="projects-heading">
	<SectionDescription
		header="Personal projects"
		subheader="Work"
		description="Selected client and side projects — mostly frontend, often with API design and real-time data."
		headingId="projects-heading"
	/>

	<ColumnsGridLayout columns={3}>
		{
			personalProjects.map((project) => (
				<ProjectCard {...project} />
			))
		}
	</ColumnsGridLayout>
</SectionLayout>
