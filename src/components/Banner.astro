---
import BannerLayout from '../layouts/BannerLayout.astro';
import { site } from '@/data/site';
---

<BannerLayout>
	<p class="mb-5 text-sm text-stone-500">
		{site.name}
	</p>

	<h1
		id="banner-heading"
		class="font-serif max-w-3xl text-4xl font-semibold leading-[1.15] tracking-tight text-stone-50 sm:text-5xl lg:text-6xl"
	>
		Senior frontend developer building interfaces for real products.
	</h1>

	<p class="mt-6 max-w-xl text-base leading-relaxed text-stone-400 sm:text-lg">
		Architecture, API design, and production UI in TypeScript — mostly React and Vue.
	</p>

	<div class="mt-10 flex flex-wrap items-center gap-3">
		<a
			href="#projects"
			class="inline-flex items-center rounded-md bg-amber-500 px-5 py-2.5 text-sm font-medium text-stone-950 transition hover:bg-amber-400"
		>
			See projects
		</a>
		<a
			href="#contact"
			class="inline-flex items-center rounded-md border border-stone-700 px-5 py-2.5 text-sm font-medium text-stone-300 transition hover:border-stone-500 hover:text-stone-100"
		>
			Contact
		</a>
	</div>
</BannerLayout>
