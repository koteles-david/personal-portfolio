---
import SectionLayout from '@/layouts/general/SectionLayout.astro';
import ColumnsGridLayout from '@/layouts/general/ColumnsGridLayout.astro';
import SectionDescription from '@/components/general/SectionDescription.astro';

import AboutMe from '@/components/about/AboutMe.astro';
import AboutPortrait from '@/components/about/AboutPortrait.astro';
import AboutTile from '@/components/about/AboutTile.astro';
import { aboutStats } from '@/data/aboutStats';
import myPhoto from '@/assets/my_photo.jpg';
---

<SectionLayout id="about" ariaLabelledby="about-heading">
	<SectionDescription
		header="Get to know me"
		subheader="About"
		headingId="about-heading"
	/>

	<ColumnsGridLayout columns={2}>
		<AboutPortrait
			initials="DK"
			name="Dávid Koteleš"
			role="Senior Frontend Developer"
			photoSrc={myPhoto.src}
		/>

		<AboutMe title="Building thoughtful digital experiences">
			<p>
				I’m a Senior Frontend Developer with 5 years of experience turning product requirements and system designs into clean, working code. I specialize in driving the entire frontend lifecycle—from mapping initial architecture and designing OpenAPI contracts to engineering scalable single-page applications.
				<br />
				I actively leverage AI tools to accelerate delivery workflows and integrate smart AI-driven features directly into modern web apps.
			</p>
			<p>
				Core Tech & Toolkit: TypeScript | React | Vue | Svelte | OpenAPI / REST | GraphQL | Sockets | AI Integration | NodeJS
			</p>
		</AboutMe>
	</ColumnsGridLayout>

	<ColumnsGridLayout columns={2}>
		{
			aboutStats.map((stat) => (
				<AboutTile {...stat} />
			))
		}
	</ColumnsGridLayout>
</SectionLayout>
