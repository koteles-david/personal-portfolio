---
const { value, label } = Astro.props;
---
<div class="rounded-2xl border border-white/10 bg-white/5 px-6 py-5 text-center backdrop-blur-sm">
    <p class="font-display text-3xl font-bold text-transparent bg-gradient-to-r from-violet-300 to-indigo-300 bg-clip-text sm:text-4xl">
        {value}
    </p>
    <p class="mt-2 text-sm font-medium text-zinc-400">{label}</p>
</div>