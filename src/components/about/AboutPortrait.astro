---
interface Props {
	initials: string;
	name: string;
	role: string;
}

const { initials, name, role } = Astro.props;
---

<div class="relative mx-auto w-full max-w-md lg:mx-0">
	<div
		aria-hidden="true"
		class="absolute -inset-3 rounded-3xl bg-gradient-to-br from-violet-600/30 via-indigo-600/20 to-fuchsia-600/30 blur-2xl"
	>
	</div>
	<div
		class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-zinc-800 via-violet-950 to-zinc-900 shadow-2xl"
	>
		<div
			class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-size-[2rem_2rem]"
		>
		</div>
		<div class="absolute inset-0 flex items-center justify-center">
			<span class="font-display text-6xl font-bold uppercase tracking-widest text-white/20">
				{initials}
			</span>
		</div>
		<div
			class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-zinc-950/90 to-transparent p-6"
		>
			<p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-zinc-300">
				{name}
			</p>
			<p class="mt-1 text-sm text-zinc-500">{role}</p>
		</div>
	</div>
</div>
