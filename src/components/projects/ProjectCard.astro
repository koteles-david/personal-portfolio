---
import type { PersonalProject } from '@/types/project';

import ProjectPreview from '@/components/projects/ProjectPreview.astro';
import ProjectWipBadge from '@/components/projects/ProjectWipBadge.astro';
import ProjectTechList from '@/components/projects/ProjectTechList.astro';
import ProjectLinks from '@/components/projects/ProjectLinks.astro';

interface Props extends PersonalProject {}

const { title, description, imageSrc, github, link, technologies, wip } = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-lg border border-stone-800 bg-[#1c1c1c] text-left transition hover:border-stone-700">
	<ProjectPreview
		imageSrc={imageSrc}
		projectTitle={title}
		wip={Boolean(wip)}
	/>

	<div class="flex flex-1 flex-col p-5">
		<div class="flex flex-wrap items-center gap-2">
			<h3 class="font-serif text-lg font-semibold text-stone-100">{title}</h3>
			{wip && <ProjectWipBadge projectTitle={title} />}
		</div>
		<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-400">{description}</p>

		<ProjectTechList projectTitle={title} technologies={technologies} />
		<ProjectLinks projectTitle={title} github={github} link={link} />
	</div>
</article>
