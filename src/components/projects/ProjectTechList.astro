---
interface Props {
	projectTitle: string;
	technologies: readonly string[];
}

const { projectTitle, technologies } = Astro.props;
---

<ul class="mt-4 flex flex-wrap gap-2" aria-label={`${projectTitle} technologies`}>
	{
		technologies.map((tech) => (
			<li>
				<span class="inline-flex rounded-md border border-stone-700 bg-stone-900/60 px-2 py-0.5 text-xs text-stone-400">
					{tech}
				</span>
			</li>
		))
	}
</ul>
