---
interface Props {
	wip?: boolean;
	imageSrc?: string;
	projectTitle: string;
}

const { wip = false, imageSrc, projectTitle } = Astro.props;
---

<div
	class="relative aspect-video overflow-hidden border-b border-stone-800 bg-stone-900"
>
	{
		imageSrc ? (
			<div class="absolute inset-0 flex items-center justify-center p-3 sm:p-4">
				<img
					src={imageSrc}
					alt={`${projectTitle} project screenshot`}
					class="max-h-full max-w-full object-contain"
					loading="lazy"
					decoding="async"
				/>
			</div>
		) : (
			<div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
				<div class="h-12 w-20 rounded border border-stone-700/60 bg-stone-800/40" />
			</div>
		)
	}
	{
		wip && (
			<div class="absolute bottom-3 left-3 rounded-md border border-stone-700 bg-stone-950/90 px-2 py-1 text-xs text-stone-400">
				In progress
			</div>
		)
	}
</div>
