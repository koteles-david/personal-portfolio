---
interface Props {
	imageGradient: string;
	wip?: boolean;
}

const { imageGradient, wip = false } = Astro.props;
---

<div
	class={`relative aspect-video overflow-hidden bg-gradient-to-br ${imageGradient}`}
	aria-hidden="true"
>
	<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-size-[1.5rem_1.5rem]" />
	<div class="absolute inset-0 flex items-center justify-center">
		<div class="h-16 w-28 rounded-lg border border-white/20 bg-white/10 shadow-2xl backdrop-blur-sm transition duration-300 group-hover:scale-105" />
	</div>
	<div class="absolute bottom-3 left-3 rounded-md bg-zinc-950/60 px-2 py-1 text-xs font-medium text-zinc-200 backdrop-blur-sm">
		{wip ? 'WIP' : 'Preview'}
	</div>
</div>
