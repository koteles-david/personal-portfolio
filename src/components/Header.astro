---
import HeaderLayout from '../layouts/HeaderLayout.astro';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Projects', href: '#projects' },
	{ label: 'About', href: '#about' },
	{ label: 'Contact', href: '#contact' },
];
---

<HeaderLayout>
	<div class="flex w-full items-center justify-between gap-8">
		<a
			href="/"
			class="font-display bg-linear-to-r from-zinc-100 via-violet-200 to-zinc-300 bg-clip-text text-sm font-bold uppercase tracking-[0.18em] text-transparent transition hover:from-white hover:via-violet-100 hover:to-white sm:text-base"
			aria-label="Dávid Koteleš — Home"
		>
			Dávid Koteleš
		</a>

		<nav aria-label="Main navigation">
			<ul class="flex items-center gap-1 sm:gap-2">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-400 transition hover:bg-white/5 hover:text-zinc-100 sm:px-4"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</HeaderLayout>
