---
import HeaderLayout from '../layouts/HeaderLayout.astro';

const navItems = [
	{ label: 'Projects', href: '#projects' },
	{ label: 'About', href: '#about' },
	{ label: 'Contact', href: '#contact' },
];
---

<HeaderLayout>
	<div class="flex w-full items-center justify-between gap-8">
		<a
			href="/"
			class="font-serif text-base font-semibold text-stone-100 transition hover:text-amber-400"
			aria-label="Dávid Koteleš — Home"
		>
			Dávid Koteleš
		</a>

		<nav aria-label="Main navigation">
			<ul class="flex items-center gap-4 sm:gap-6">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="text-sm text-stone-500 underline-offset-4 transition hover:text-stone-200 hover:underline"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</HeaderLayout>
