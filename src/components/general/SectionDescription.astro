---
interface Props {
	header: string;
	subheader: string;
	description?: string;
	headingId?: string;
}

const { header, subheader, description = '', headingId } = Astro.props;
---
<div class="max-w-2xl">
	<p class="mb-2 text-sm font-medium text-amber-500/90">
		{subheader}
	</p>
	<h2
		id={headingId}
		class="font-serif text-3xl font-semibold tracking-tight text-stone-50 sm:text-4xl"
	>
		{header}
	</h2>
	{
		description && (
			<p class="mt-4 text-base leading-relaxed text-stone-400 sm:text-lg">
				{description}
			</p>
		)
	}
</div>
