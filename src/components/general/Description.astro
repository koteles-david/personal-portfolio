---
interface Props {
	header: string;
	subheader: string;
	description?: string;
	headingId?: string;
}

const { header, subheader, description = '', headingId } = Astro.props;
---
<p class="mb-3 font-display text-xs font-semibold uppercase tracking-[0.3em] text-violet-300/80">
	{subheader}
</p>
<h2
	id={headingId}
	class="relative font-display text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl lg:text-5xl"
>
	{header}
</h2>
{
	description && (
		<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400 sm:text-xl">
			{description}
		</p>
	)
}