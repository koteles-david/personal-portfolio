---
interface Props {
	name: string;
	level: number;
	levelLabel: string;
	description: string;
	accent: string;
	chip: string;
}

const { name, level, levelLabel, description } = Astro.props;
---
<article class="rounded-lg border border-stone-800 bg-[#1c1c1c] p-5 transition hover:border-stone-700">
	<div class="mb-4 flex items-start justify-between gap-3">
		<div>
			<h3 class="font-serif text-lg font-semibold text-stone-100">{name}</h3>
			<p class="mt-1 text-xs text-stone-500">
				{levelLabel}
			</p>
		</div>
		<span class="text-xs font-medium tabular-nums text-stone-500">
			{level}%
		</span>
	</div>

	<p class="text-sm leading-relaxed text-stone-400">{description}</p>

	<div class="mt-4">
		<div
			class="h-1 overflow-hidden rounded-full bg-stone-800"
			role="progressbar"
			aria-valuenow={level}
			aria-valuemin={0}
			aria-valuemax={100}
			aria-label={`${name} proficiency`}
		>
			<div
				class="h-full rounded-full bg-amber-500/80"
				style={`width: ${level}%`}
			/>
		</div>
	</div>
</article>
