---
interface Props {
	title: string;
	skills: readonly string[];
}

const { title, skills } = Astro.props;
---
<div class="rounded-2xl border border-white/10 bg-zinc-900/40 p-5">
    <h3 class="font-display text-sm font-semibold uppercase tracking-[0.15em] text-zinc-300">
        {title}
    </h3>
    <ul class="mt-4 flex flex-wrap gap-2">
        {skills.map((skill) => (
            <li>
                <span class="inline-flex rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-zinc-300">
                    {skill}
                </span>
            </li>
        ))}
    </ul>
</div>