---
interface Props {
	title: string;
	skills: readonly string[];
}

const { title, skills } = Astro.props;
---
<div class="rounded-lg border border-stone-800 bg-[#1c1c1c] p-5">
	<h3 class="font-serif text-base font-semibold text-stone-200">
		{title}
	</h3>
	<ul class="mt-4 flex flex-wrap gap-2">
		{
			skills.map((skill) => (
				<li>
					<span class="inline-flex rounded-md border border-stone-700 bg-stone-900/60 px-2.5 py-1 text-xs text-stone-400">
						{skill}
					</span>
				</li>
			))
		}
	</ul>
</div>
