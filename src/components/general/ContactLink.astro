---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../types/icon';

interface Props {
	href: string;
	icon: IconName;
	label: string;
	value: string;
	description: string;
}

const { href, icon, label, value, description } = Astro.props;
---

<a
	href={href}
	target={icon === 'email' ? undefined : '_blank'}
	rel={icon === 'email' ? undefined : 'noopener noreferrer'}
	class="group flex flex-col items-center rounded-2xl border border-white/10 bg-zinc-950/40 px-5 py-6 transition hover:border-violet-400/30 hover:bg-white/[0.07]"
>
	<span class="mb-3 flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-zinc-300 transition group-hover:border-violet-400/30 group-hover:text-violet-200">
		<Icon name={icon} />
	</span>
	<span class="font-display text-sm font-semibold text-zinc-50">{label}</span>
	<span class="mt-1 text-xs text-violet-300/90 transition group-hover:text-violet-200">
		{value}
	</span>
	<span class="mt-2 text-xs leading-relaxed text-zinc-500">{description}</span>
</a>