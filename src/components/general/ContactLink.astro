---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../types/icon';

interface Props {
	href: string;
	icon: IconName;
	label: string;
	value: string;
	description: string;
}

const { href, icon, label, value, description } = Astro.props;
---

<a
	href={href}
	target={icon === 'email' ? undefined : '_blank'}
	rel={icon === 'email' ? undefined : 'noopener noreferrer'}
	class="group flex flex-col rounded-lg border border-stone-800 bg-[#1c1c1c] px-5 py-6 transition hover:border-stone-600"
>
	<span class="mb-4 flex h-9 w-9 items-center justify-center rounded-md border border-stone-700 text-stone-400 transition group-hover:border-amber-500/40 group-hover:text-amber-400">
		<Icon name={icon} />
	</span>
	<span class="font-serif text-sm font-semibold text-stone-100">{label}</span>
	<span class="mt-1 text-xs text-stone-500 transition group-hover:text-stone-400">
		{value}
	</span>
	<span class="mt-2 text-xs leading-relaxed text-stone-600">{description}</span>
</a>
