---
import '../styles/global.css';
import Seo from '@/components/seo/Seo.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	path?: string;
	noIndex?: boolean;
}

const { title, description, image, path, noIndex } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} image={image} path={path} noIndex={noIndex} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:ital,wght@0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="flex min-h-screen flex-col text-stone-200 antialiased selection:bg-amber-500/30 selection:text-stone-50"
	>
		<slot />
	</body>
</html>
