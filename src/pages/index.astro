---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import PersonalProjects from '../components/PersonalProjects.astro';
import TechnicalExpertise from '../components/TechnicalExpertise.astro';
import About from '@/components/about/About.astro';
import Contact from '@/components/Contact.astro';
import { site } from '@/data/site';
---

<Layout path="/" title={site.title} description={site.description}>
    <Header />
    <Banner />
    <PersonalProjects />
    <TechnicalExpertise />
    <About />
    <Contact />
</Layout>
